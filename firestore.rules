rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isStudent() {
      return isSignedIn() && role() == 'student';
    }

    function isTeacher() {
      return isSignedIn() && role() == 'teacher';
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isTeacherOrAdmin() {
      return isTeacher() || isAdmin();
    }

    // Fallback: read role from Firestore user doc (for accounts without custom claims)
    function docRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return isSignedIn() && (
        role() in ['teacher', 'admin'] ||
        docRole() in ['teacher', 'admin']
      );
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function inCohort(cohortId) {
      return isSignedIn() && request.auth.token.cohortId == cohortId;
    }

    // ── Users ─────────────────────────────────────────────────────────────────

    match /users/{userId} {
      // FCM tokens live in this doc — restrict to self and staff
      allow read: if request.auth.uid == userId || isTeacherOrAdmin();
      // Self can update non-privileged display fields (not points/role)
      allow update: if isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'totalPoints', 'pointsRedeemed']);
      // Any signed-in user can update their own lastReadAt (cross-device badge clearing)
      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt']);
      // Teachers/admins may update totalPoints (absence penalty)
      allow update: if isTeacherOrAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPoints']);
      // Admins can update any field (cohortId, isActive, roles, etc.)
      allow update: if isAdmin();
      // Users create their own document during invite signup
      allow create: if isSelf(userId);
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ── Cohorts ───────────────────────────────────────────────────────────────

    match /cohorts/{cohortId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    // ── Subjects ──────────────────────────────────────────────────────────────

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    // ── Lessons ───────────────────────────────────────────────────────────────

    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    // ── Assignments ───────────────────────────────────────────────────────────

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    // ── Tests — students CANNOT read correctAnswer fields directly ────────────
    // Students get questions through the getTestQuestions Cloud Function which
    // strips correct answers before returning them.

    match /tests/{testId} {
      allow read: if isTeacherOrAdmin();
      allow write: if isTeacherOrAdmin();
      // Students: no direct read access
    }

    // ── Submissions ───────────────────────────────────────────────────────────

    match /submissions/{submissionId} {
      // Students can read their own; teachers/admins can read all
      allow read: if isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      // Students can create/update their own draft submissions
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'draft';
      allow update: if isStudent()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'draft'
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['score', 'passed', 'pointsAwarded', 'gradedBy', 'gradedAt']);
      // Grading goes through Cloud Functions only
      allow delete: if false;
    }

    // ── Points log — append-only, Cloud Functions only ────────────────────────

    match /points_log/{logId} {
      allow read: if isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      // Only Cloud Functions write points; no client writes allowed
      allow write: if false;
    }

    // ── Prizes ────────────────────────────────────────────────────────────────

    match /prizes/{prizeId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    // ── Prize claims ──────────────────────────────────────────────────────────

    match /prize_claims/{claimId} {
      allow read: if isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if false; // processRedemption Cloud Function only
    }

    // ── Progress (denormalized summary per student) ───────────────────────────

    match /progress/{studentId} {
      allow read: if isSelf(studentId) || isTeacherOrAdmin();
      allow write: if false; // updateProgress Cloud Function only
    }

    // ── Invitations ───────────────────────────────────────────────────────────

    match /invitations/{token} {
      allow read: if true
        && (!('expiresAt' in resource.data) || resource.data.expiresAt > request.time)
        && resource.data.used != true;
      allow write: if isTeacherOrAdmin();
      // Invited user may mark their own invite as used after creating their account
      allow update: if isSignedIn()
        && resource.data.email == request.auth.token.email
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']);
    }

    // ── Global settings (school day hours, etc.) ──────────────────────────────
    // settings/booking is publicly readable for the unauthenticated iPad kiosk display.

    match /settings/{docId} {
      allow read: if isSignedIn() || docId == 'booking';
      allow write: if isAdmin();
    }

    match /settings/production {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    // ── Subject teachers (subcollection) ─────────────────────────────────────

    match /subjects/{subjectId}/teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    // ── Lesson Blocks ─────────────────────────────────────────────────────────

    match /lessonCategories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    match /lessonBlocks/{blockId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Classrooms ────────────────────────────────────────────────────────────

    match /classrooms/{classroomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Attendance sessions ───────────────────────────────────────────────────

    match /attendance_sessions/{sessionId} {
      allow read: if true; // public — QR display devices need unauthenticated read
      allow write: if isTeacherOrAdmin();
    }

    // ── QR Display Devices ────────────────────────────────────────────────────

    match /qr_display_devices/{deviceId} {
      allow read: if true; // public — display devices are unauthenticated
      allow create, delete: if isAdmin();
      allow update: if isTeacherOrAdmin(); // teachers write session state; admins manage device config
    }

    // ── Lesson attendance (subcollection) ────────────────────────────────────

    match /lessons/{lessonId}/attendance/{studentId} {
      allow read: if isSelf(studentId) || isTeacherOrAdmin();
      allow write: if isSignedIn() && request.auth.uid == studentId;
    }

    // ── Room booking ──────────────────────────────────────────────────────────
    // rooms and time_blocks are publicly readable for the iPad display page.

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /time_blocks/{blockId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /room_bookings/{bookingId} {
      allow read: if isSignedIn() || request.auth == null; // signed-in users + iPad display
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow delete: if isStaff()
        || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow update: if false;
    }

    // ── Chat ─────────────────────────────────────────────────────────────────

    match /chat_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /chat_channels/{channelId} {
      // All signed-in users can read channel metadata; client-side filters visibility
      allow read: if isSignedIn();
      // Any signed-in user can create a channel or DM
      allow create: if isSignedIn();
      allow update, delete: if isTeacherOrAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn();
        // Any signed-in user can post (access already gated by client-side channel filter)
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid;
        // Author or staff can delete
        allow delete: if isSignedIn()
          && (resource.data.authorId == request.auth.uid || isStaff());
        allow update: if isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      }
    }

    // ── Production teams ──────────────────────────────────────────────────────

    match /production_teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    // ── Videos ───────────────────────────────────────────────────────────────

    match /videos/{videoId} {
      allow read: if isSignedIn();
      // Students create their own; teachers/admins can update (grade/review)
      allow create: if isStudent()
        && request.resource.data.uploaderId == request.auth.uid;
      allow update: if isTeacherOrAdmin()
        || (isStudent() && resource.data.uploaderId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['reviewStatus', 'grade', 'gradedBy', 'gradedAt', 'feedback']));
      allow delete: if isTeacherOrAdmin();
    }

    match /video_comments/{videoId}/comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isTeacherOrAdmin());
      allow update: if false;
    }

    // ── Absence Reports ───────────────────────────────────────────────────────

    match /absence_reports/{reportId} {
      allow read: if isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacherOrAdmin();
      allow delete: if isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
    }

    // ── Video Lab (Beta) ─────────────────────────────────────────────────────

    match /video_lab/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isTeacherOrAdmin()
        || (isStudent() && resource.data.uploaderId == request.auth.uid);
      allow delete: if isTeacherOrAdmin()
        || (isStudent() && resource.data.uploaderId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn()
          && (resource.data.userId == request.auth.uid || isTeacherOrAdmin());
        allow update: if false;
      }
    }

    // ── Production Bible / Student Guide ─────────────────────────────────────

    match /guide_sections/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /guide_articles/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /guide_contacts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Vehicles ─────────────────────────────────────────────────────────────

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    // ── Food Box Orders ───────────────────────────────────────────────────────

    match /food_box_orders/{orderId} {
      allow read: if isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacherOrAdmin();
      allow delete: if isTeacherOrAdmin();
    }

    // ── Minivan Bookings ──────────────────────────────────────────────────────

    match /minivan_bookings/{bookingId} {
      allow read: if isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacherOrAdmin();
      allow delete: if isTeacherOrAdmin();
    }

    // ── Email Config ──────────────────────────────────────────────────────────

    match /email_config/{docId} {
      allow read: if isTeacherOrAdmin();
      allow write: if isAdmin();
    }

    // ── Equipment Booking System ───────────────────────────────────────────────

    match /equipment/{itemId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    match /equipment_bookings/{bookingId} {
      allow read: if isTeacherOrAdmin()
        || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacherOrAdmin();
    }

    match /inventory_projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();

      match /items/{itemId} {
        allow read: if isSignedIn();
        allow write: if isTeacherOrAdmin();
      }
    }

    // Collection group rule required for collectionGroup('items') queries
    match /{path=**}/items/{itemId} {
      allow read: if isSignedIn();
    }

    // ── Scan sessions (cross-device QR scanning) ──────────────────────────────

    match /scan_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrAdmin();
      allow update: if isTeacherOrAdmin();

      match /checkins/{checkinId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn(); // mobile scanners write check-in signals
      }
    }

    // ── Individual Development Plans (NOPRA) ──────────────────────────────────

    match /development_plans/{studentId} {
      allow read: if isSelf(studentId) || isTeacherOrAdmin();
      allow write: if isSelf(studentId);
    }

    // ── Plan comments (teacher → student feedback) ────────────────────────────

    match /plan_comments/{commentId} {
      allow read: if isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isTeacherOrAdmin()
        && request.resource.data.teacherId == request.auth.uid;
      allow delete: if isTeacherOrAdmin();
      allow update: if false;
    }

    // ── Semester Events (Annual Wheel) ────────────────────────────────────────

    match /semester_events/{eventId} {
      allow read: if isTeacherOrAdmin();
      allow write: if isAdmin();
    }

    match /semester_categories/{catId} {
      allow read: if isTeacherOrAdmin();
      allow write: if isAdmin();
    }

    // ── Teacher Notebook ─────────────────────────────────────────────────

    match /teacher_notes/{noteId} {
      allow read, write: if isTeacherOrAdmin();
    }

    // ── GDPR deletion log — append by admins, read by admins ─────────────

    match /deletion_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Personal calendar events ──────────────────────────────────────────────

    match /personal_events/{eventId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || request.auth.uid in resource.data.inviteeIds);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── Team Resources ────────────────────────────────────────────────────────

    match /resource_folders/{folderId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
      // Students can create folders scoped to their own cohort (class resources)
      allow create: if isStudent()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.cohortId != null;
    }

    match /team_resources/{resourceId} {
      allow read: if isSignedIn();
      // Teachers/admins can create any resource; students can only create class resources (cohortId != null)
      allow create: if isTeacherOrAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow create: if isStudent()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.cohortId != null;
      allow update, delete: if isTeacherOrAdmin();
    }

    // ── Teacher Assessments (strengths / developments per student) ───────────

    match /teacher_assessments/{studentId} {
      // Students can read their own; teachers/admins can read all
      allow read: if isSelf(studentId) || isTeacherOrAdmin();
      // Only teachers/admins can write assessments
      allow write: if isTeacherOrAdmin();
    }

    // ── Crew Roles (admin-managed, student-readable) ──────────────────────────

    match /crew_roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Production Planning ───────────────────────────────────────────────────

    match /productions/{productionId} {
      function prodData() { return resource.data; }
      function canEditProd() {
        return prodData().createdBy == request.auth.uid
          || request.auth.uid in prodData().collaborators
          || isTeacherOrAdmin();
      }
      function canReadProd() {
        return canEditProd()
          || (prodData().isPublic && prodData().cohortId == request.auth.token.cohortId)
          || (prodData().viewerIds != null && request.auth.uid in prodData().viewerIds);
      }

      allow read:   if isSignedIn() && canReadProd();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && canEditProd();
      allow delete: if isSignedIn()
        && (prodData().createdBy == request.auth.uid || isTeacherOrAdmin());

      match /shotlog/{entryId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      match /{subcol}/{docId} {
        function parentProd() {
          return get(/databases/$(database)/documents/productions/$(productionId)).data;
        }
        function canEditSub() {
          return parentProd().createdBy == request.auth.uid
            || request.auth.uid in parentProd().collaborators
            || isTeacherOrAdmin();
        }
        allow read: if isSignedIn();
        allow write: if isSignedIn() && canEditSub();
      }
    }

    // ── Master Production Period ──────────────────────────────────────────────

    match /production_periods/{periodId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrAdmin();
      allow update: if isTeacherOrAdmin();
      allow delete: if isTeacherOrAdmin();

      match /allocations/{allocationId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn()
          && (resource.data.createdBy == request.auth.uid || isTeacherOrAdmin());
        allow delete: if isSignedIn()
          && (resource.data.createdBy == request.auth.uid || isTeacherOrAdmin());
      }
    }

    // ── Student to-do items ───────────────────────────────────────────────────

    match /todos/{todoId} {
      // Ownership check rather than isStudent() — custom claims may not be set
      allow read: if isSignedIn() && (
        isTeacherOrAdmin() || resource.data.studentId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.studentId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.studentId == request.auth.uid;
    }

    // ── Schools ───────────────────────────────────────────────────────────────

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email in ['fredrik.fridlund@gmail.com'];
    }

    match /schools/{schoolId} {
      // Public existence check — allows unauthenticated slug availability check on signup
      allow get: if true;
      // Listing requires auth + admin role or superadmin email
      allow list: if isSignedIn() && (isAdmin() || isSuperAdmin());
      allow create: if isSignedIn() && (isAdmin() || isSuperAdmin())
        && request.resource.data.schoolId == schoolId
        && !exists(/databases/$(database)/documents/schools/$(schoolId));
      allow update: if isSignedIn() && (isAdmin() || isSuperAdmin());
      allow delete: if false;
    }

    // ── Notification inbox ────────────────────────────────────────────────────

    match /notifications/{notifId} {
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }
  }
}
