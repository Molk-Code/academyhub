# Local testing against the Firebase emulators:
#   firebase emulators:start --only auth,firestore,functions --project demo-cineforge
#   npx vite --mode emulator
# demo- project ids never reach a real Firebase project. No secrets here.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-cineforge.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-cineforge
VITE_FIREBASE_STORAGE_BUCKET=demo-cineforge.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:0
VITE_FIREBASE_VAPID_KEY=
VITE_FUNCTIONS_REGION=us-central1
VITE_USE_EMULATORS=true
# Emulator-only superadmin (the seeded admin account)
VITE_SUPERADMIN_EMAILS=admin@example.test

# Public site address: robots.txt and sitemap.xml (no trailing slash)
VITE_SITE_URL=http://localhost:5173
