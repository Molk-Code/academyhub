rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    // Any Firebase Auth login, including one created straight against the API
    // without an invite. Only for the signup steps themselves (own profile doc,
    // own push tokens) — school data uses isSignedIn() below.
    function isAuthed() {
      return request.auth != null;
    }

    // A member of the school: has a role claim (set from an invite / class
    // signup) or, for older accounts without claims, a profile doc. The
    // exists() read only runs when the claim is missing.
    function isSignedIn() {
      return request.auth != null && (
        request.auth.token.get('role', '') in ['student', 'teacher', 'admin']
        || exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    function role() {
      // .get() with a default — a bare `.role` access throws when the custom
      // claim isn't set at all, which (since `||` only short-circuits on a
      // determining true/false, not on an error) poisons every isStudent()/
      // isTeacher()/isAdmin() check built on it into a hard permission-denied
      // instead of a clean false. Some accounts in this project genuinely
      // don't have the claim set (see docRole() below) — this must never throw.
      return request.auth.token.get('role', '');
    }

    // Fallback: read role from Firestore user doc (for accounts without custom claims)
    function docRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Trusts docRole() (the Firestore user doc) as a fallback here, unlike
    // isTeacher()/isAdmin() below — safe specifically because 'student' is
    // the floor of privilege: a doc self-declaring it can't grant anything
    // beyond a brand-new account's own default role.
    function isStudent() {
      return isSignedIn() && (role() == 'student' || docRole() == 'student');
    }

    // Deliberately claim-only (no docRole() fallback) — the users/{uid}
    // `create` rule lets a new account set its own `role` field to anything
    // with no server-side validation, so trusting docRole() for an
    // elevated-privilege check would let a signup self-grant staff access.
    // isStaff() below predates this distinction and already carries that
    // exposure; not widening it further here.
    function isTeacher() {
      return isSignedIn() && role() == 'teacher';
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isTeacherOrAdmin() {
      return isTeacher() || isAdmin();
    }

    function isStaff() {
      return isSignedIn() && (
        role() in ['teacher', 'admin'] ||
        docRole() in ['teacher', 'admin']
      );
    }

    function isSelf(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // ── Tier / Feature gating ─────────────────────────────────────────────────
    // Mirrors src/lib/features.ts — keep the two in sync when tier features change.

    function schoolTier() {
      return get(/databases/$(database)/documents/schools/molkom).data.get('tier', null);
    }

    function tierHasFeature(feature) {
      let tier = schoolTier();
      return tier == null   ? true :
             tier == 'studio'  ? true :
             tier == 'academy' ? feature in ['booking', 'vehicles', 'food_box',
               'checkin_devices', 'resources', 'prizes', 'video_lab', 'chat', 'calendar',
               'assignments', 'lessons', 'development_plan', 'semester', 'faq'] :
             tier == 'campus'  ? feature in ['chat', 'calendar', 'assignments',
               'lessons', 'development_plan', 'semester', 'faq'] :
             false;
    }

    function isRentalMode() {
      return get(/databases/$(database)/documents/schools/molkom).data.get('productType', null) == 'rental';
    }

    // ── Modules ───────────────────────────────────────────────────────────────
    // schools/molkom.modules = { academy, production, rentalInventory }, set by
    // the superadmin. Absent (every legacy school) → every module on, so the
    // tier checks above keep deciding exactly as before. Added as an extra
    // condition on the collections of each module, with no admin bypass.
    // Same document as schoolTier(), so where both run it is one read.

    function moduleOn(flag) {
      let modules = get(/databases/$(database)/documents/schools/molkom).data.get('modules', null);
      return modules == null || modules.get(flag, false) == true;
    }

    // settings/{docId} also matches the module-owned settings documents —
    // overlapping matches are OR'ed, so the generic block has to gate them too
    function settingsModuleOn(docId) {
      return docId in ['booking', 'semester'] ? moduleOn('academy')
        : docId == 'production' ? moduleOn('production')
        : docId in ['equipment_gtin', 'inventory_stats_resets'] ? moduleOn('rentalInventory')
        : true;
    }

    // ── Users ─────────────────────────────────────────────────────────────────

    function validNewUser(d) {
      return d.get('totalPoints', 0) == 0
        && d.get('pointsRedeemed', 0) == 0
        && d.get('disabled', false) == false
        && d.get('displayName', '').size() <= 80
        && (
          // Student from an active class invite (QR) — joins exactly that class
          (d.role == 'student' && d.get('roles', ['student']) == ['student']
            && d.get('classInviteId', '') != ''
            && get(/databases/$(database)/documents/classInvites/$(d.classInviteId)).data.get('active', false) == true
            && get(/databases/$(database)/documents/classInvites/$(d.classInviteId)).data.cohortId == d.get('cohortId', null))
          ||
          // Email invitation — role and class must be exactly what it grants
          (d.get('inviteId', '') != ''
            && get(/databases/$(database)/documents/invitations/$(d.inviteId)).data.email.lower() == request.auth.token.email.lower()
            && get(/databases/$(database)/documents/invitations/$(d.inviteId)).data.role == d.role
            && d.get('roles', [d.role]) == [d.role]
            && get(/databases/$(database)/documents/invitations/$(d.inviteId)).data.get('cohortId', null) == d.get('cohortId', null))
        );
    }

    match /users/{userId} {
      // get (single doc by ID): self or staff — guards FCM tokens and email from bulk scraping
      allow get: if request.auth.uid == userId || isTeacherOrAdmin();
      // list (collection queries): any signed-in user — required for DM picker and leaderboard
      allow list: if isSignedIn();
      // Self can update their own display/profile fields only — never role(s),
      // class, points, active/disabled state or anything else privileged
      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'schoolEmail', 'email', 'avatarUrl',
          'bio', 'portfolioUrl', 'calendarColor', 'hasSeenWelcome',
          'gdprConsent', 'privacyAcceptedAt', 'lastReadAt',
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.trim().size() >= 2
                && request.resource.data.displayName.size() <= 80));
      // Teachers/admins may update totalPoints (absence penalty)
      allow update: if isTeacherOrAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPoints']);
      // Admins can update any field (cohortId, isActive, roles, etc.)
      allow update: if isAdmin();
      // Users create their own document during invite signup. The browser writes
      // it, so role and class are checked against the invite it came from: a
      // plain signup is always a student, staff roles need a matching invitation.
      allow create: if isSelf(userId) && validNewUser(request.resource.data);
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Device push tokens — only the owner reads/writes; functions use the Admin SDK
    match /push_tokens/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['tokens'])
        && request.resource.data.tokens is list
        && request.resource.data.tokens.size() <= 20;
      allow delete: if isSelf(userId);
    }

    // ── Cohorts ───────────────────────────────────────────────────────────────

    match /cohorts/{cohortId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrAdmin();
    }

    // ── Subjects ──────────────────────────────────────────────────────────────

    match /subjects/{subjectId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── Lessons ───────────────────────────────────────────────────────────────

    match /lessons/{lessonId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── Assignments ───────────────────────────────────────────────────────────

    match /assignments/{assignmentId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── Tests — students CANNOT read correctAnswer fields directly ────────────
    // Students get questions through the getTestQuestions Cloud Function which
    // strips correct answers before returning them.

    match /tests/{testId} {
      allow read: if (isTeacherOrAdmin()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
      // Students: no direct read access
    }

    // ── Checklists — no secret data (no "correct answer" per item), so
    // students can read the step list directly; submitChecklist (Cloud
    // Function) still validates/writes the submission itself.
    match /checklists/{checklistId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── Submissions ───────────────────────────────────────────────────────────

    match /submissions/{submissionId} {
      // Students can read their own; teachers/admins can read all
      allow read: if (isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)) && moduleOn('academy');
      // Students can create/update their own draft submissions
      allow create: if (isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status in ['draft', 'submitted']) && moduleOn('academy');
      allow update: if (isStudent()
        && resource.data.studentId == request.auth.uid
        && resource.data.status == 'draft'
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['score', 'passed', 'pointsAwarded', 'gradedBy', 'gradedAt'])) && moduleOn('academy');
      // Grading goes through Cloud Functions only
      allow delete: if (false) && moduleOn('academy');
    }

    // ── Points log — append-only, Cloud Functions only ────────────────────────

    match /points_log/{logId} {
      allow read: if (isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)) && moduleOn('academy');
      // Only Cloud Functions write points; no client writes allowed
      allow write: if (false) && moduleOn('academy');
    }

    // ── Prizes ────────────────────────────────────────────────────────────────

    match /prizes/{prizeId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── Prize claims ──────────────────────────────────────────────────────────

    match /prize_claims/{claimId} {
      allow read: if (isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)) && moduleOn('academy');
      allow write: if (false) && moduleOn('academy'); // processRedemption Cloud Function only
    }

    // ── Progress (denormalized summary per student) ───────────────────────────

    match /progress/{studentId} {
      allow read: if (isSelf(studentId) || isTeacherOrAdmin()) && moduleOn('academy');
      allow write: if (false) && moduleOn('academy'); // updateProgress Cloud Function only
    }

    // ── Invitations ───────────────────────────────────────────────────────────

    match /invitations/{token} {
      // get (single doc by ID) is public — signup page validates token before account creation
      // list is admin-only so signed-in students cannot enumerate all pending invites
      allow get: if !('expiresAt' in resource.data) || resource.data.expiresAt > request.time;
      allow list: if isAdmin();
      allow write: if isTeacherOrAdmin();
      // Invited user may mark their own invite as used after creating their account.
      // Case-insensitive email match because Firebase Auth tokens store email in lowercase.
      allow update: if isSignedIn()
        && resource.data.email.lower() == request.auth.token.email.lower()
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']);
    }

    // Reusable, class-scoped QR invite — many students may register through the same
    // invite doc, so unlike /invitations there is no single-email binding or used flag.
    match /classInvites/{inviteId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isTeacherOrAdmin();
      allow update: if isTeacherOrAdmin()
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount']));
    }

    // ── Global settings (school day hours, etc.) ──────────────────────────────
    // settings/booking and settings/semester are publicly readable for the
    // unauthenticated iPad room display (semester dates bound room availability).

    match /settings/{docId} {
      allow get: if (isSignedIn() || docId in ['booking', 'semester']) && settingsModuleOn(docId);
      // A list can't be checked per document: allowed only while every module
      // that owns a settings doc is on (always, for legacy schools)
      allow list: if (isSignedIn() || docId in ['booking', 'semester'])
        && moduleOn('academy') && moduleOn('production') && moduleOn('rentalInventory');
      allow write: if (isAdmin()) && settingsModuleOn(docId);
    }

    match /settings/production {
      allow read: if (isSignedIn()) && moduleOn('production');
      allow write: if (isTeacherOrAdmin()) && moduleOn('production');
    }

    // Counter for EAN-14 equipment numbers, bumped when staff print a label
    match /settings/equipment_gtin {
      allow read: if (isSignedIn()) && moduleOn('rentalInventory');
      allow write: if (isTeacherOrAdmin()) && moduleOn('rentalInventory');
    }

    match /settings/inventory_stats_resets {
      allow read: if (isSignedIn()) && moduleOn('rentalInventory');
      allow write: if (isTeacherOrAdmin()) && moduleOn('rentalInventory');
    }

    // ── Subject teachers (subcollection) ─────────────────────────────────────

    match /subjects/{subjectId}/teachers/{teacherId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── Lesson Blocks ─────────────────────────────────────────────────────────

    match /lessonCategories/{categoryId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    match /lessonBlocks/{blockId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isAdmin()) && moduleOn('academy');
    }

    // ── Classrooms ────────────────────────────────────────────────────────────

    match /classrooms/{classroomId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isAdmin()) && moduleOn('academy');
    }

    // ── Attendance sessions ───────────────────────────────────────────────────

    // Holds the live check-in token — staff only. Displays read the token from
    // qr_display_devices/{id}/live/{displayKey} instead.
    match /attendance_sessions/{sessionId} {
      allow read: if (isTeacherOrAdmin()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── QR Display Devices ────────────────────────────────────────────────────

    match /qr_display_devices/{deviceId} {
      allow read: if (true) && moduleOn('academy'); // public — display devices are unauthenticated (name/state only)
      allow create, delete: if (isAdmin()) && moduleOn('academy');
      // teachers write session state; admins manage device config. The token itself
      // never goes on this public doc.
      allow update: if (isTeacherOrAdmin() && request.resource.data.get('activeToken', null) == null) && moduleOn('academy');

      // The display's secret link key — staff need it to publish the token
      match /private/{docId} {
        allow read: if (isTeacherOrAdmin()) && moduleOn('academy');
        allow write: if (isAdmin()) && moduleOn('academy');
      }
      // Live token, stored under the secret key: readable only by whoever has
      // the display link (get by exact id, never listed)
      match /live/{displayKey} {
        allow get: if (true) && moduleOn('academy');
        allow list: if (false) && moduleOn('academy');
        allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
      }
    }

    // ── Lesson attendance (subcollection) ────────────────────────────────────
    // Writes go through checkInAttendance Cloud Function (Admin SDK) only.
    match /lessons/{lessonId}/attendance/{studentId} {
      allow read: if (isSelf(studentId) || isTeacherOrAdmin()) && moduleOn('academy');
      allow write: if (false) && moduleOn('academy');
    }

    // ── Room booking ──────────────────────────────────────────────────────────
    // rooms and time_blocks are publicly readable for the iPad display page.

    match /rooms/{roomId} {
      allow read: if (true) && moduleOn('academy');
      allow write: if (isStaff()) && moduleOn('academy');
    }

    match /time_blocks/{blockId} {
      allow read: if (true) && moduleOn('academy');
      allow write: if (isStaff()) && moduleOn('academy');
    }

    // Public, reduced copy for the signed-out room display — written by the
    // onRoomBookingWritten function only (room, time, first name)
    match /room_slots/{slotId} {
      allow read: if (true) && moduleOn('academy');
      allow write: if (false) && moduleOn('academy');
    }

    match /room_bookings/{bookingId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow create: if (isSignedIn()
        && request.resource.data.studentId == request.auth.uid) && moduleOn('academy');
      allow delete: if (isStaff()
        || (isSignedIn() && resource.data.studentId == request.auth.uid)) && moduleOn('academy');
      allow update: if (false) && moduleOn('academy');
    }

    // ── Chat ─────────────────────────────────────────────────────────────────

    match /chat_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /chat_channels/{channelId} {
      // All signed-in users can read channel metadata; client-side canAccessChannel() filters UI
      allow read: if isSignedIn();
      // DMs can be created by any signed-in user (must include own UID in memberIds)
      allow create: if isSignedIn()
        && request.resource.data.isDM == true
        && request.auth.uid in request.resource.data.memberIds;
      // Broadcast channels are staff-only
      allow create: if isTeacherOrAdmin() && request.resource.data.get('isDM', false) != true;
      allow update, delete: if isTeacherOrAdmin();

      match /messages/{messageId} {
        // Channel access: public, member, role-match, or cohort-match. DMs are
        // never public — only their members (and staff) get in.
        function canAccessChannel() {
          let ch = get(/databases/$(database)/documents/chat_channels/$(channelId)).data;
          return isTeacherOrAdmin()
            || (ch.get('isDM', false) != true && ch.get('isPublic', true) != false)
            || request.auth.uid in ch.get('memberIds', [])
            || role() in ch.get('allowedRoles', [])
            || (request.auth.token.get('cohortId', null) != null
                && request.auth.token.cohortId in ch.get('allowedCohortIds', []));
        }
        allow read: if isSignedIn() && canAccessChannel();
        // Only people who can see the channel may post in it, as themselves
        allow create: if isSignedIn() && canAccessChannel()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.get('content', '').size() <= 4000
          && postThrottled();
        // One message per second per person: the same batch must stamp
        // chat_throttle/{uid}.lastPost with this request's time, and the
        // previous stamp must be over a second old
        function postThrottled() {
          let path = /databases/$(database)/documents/chat_throttle/$(request.auth.uid);
          return getAfter(path).data.lastPost == request.time
            && (!exists(path) || request.time > get(path).data.lastPost + duration.value(1, 's'));
        }
        // Author or staff can delete
        allow delete: if isSignedIn()
          && (resource.data.authorId == request.auth.uid || isStaff());
        // Reactions only, by people who can see the channel
        allow update: if isSignedIn() && canAccessChannel()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      }
    }

    match /chat_throttle/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['lastPost'])
        && request.resource.data.lastPost == request.time;
    }

    // ── Production teams ──────────────────────────────────────────────────────

    match /production_teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if (isTeacherOrAdmin()) && moduleOn('production');
    }

    // ── Videos ───────────────────────────────────────────────────────────────

    match /videos/{videoId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      // Students create their own; teachers/admins can update (grade/review)
      allow create: if (isStudent()
        && request.resource.data.uploaderId == request.auth.uid) && moduleOn('academy');
      allow update: if (isTeacherOrAdmin()
        || (isStudent() && resource.data.uploaderId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['reviewStatus', 'grade', 'gradedBy', 'gradedAt', 'feedback']))) && moduleOn('academy');
      allow delete: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    match /video_comments/{videoId}/comments/{commentId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow create: if (isSignedIn()
        && request.resource.data.userId == request.auth.uid) && moduleOn('academy');
      allow delete: if (isSignedIn()
        && (resource.data.userId == request.auth.uid || isTeacherOrAdmin())) && moduleOn('academy');
      allow update: if (false) && moduleOn('academy');
    }

    // ── Absence Reports ───────────────────────────────────────────────────────

    match /absence_reports/{reportId} {
      allow get: if (isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)) && moduleOn('academy');
      allow list: if (isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)) && moduleOn('academy');
      allow create: if ((isStudent() && request.resource.data.studentId == request.auth.uid)
        || isTeacherOrAdmin()) && moduleOn('academy');
      allow update: if (isTeacherOrAdmin()) && moduleOn('academy');
      allow delete: if (isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)) && moduleOn('academy');
    }

    // ── Video Lab (Beta) ─────────────────────────────────────────────────────

    match /video_lab/{videoId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow create: if (isSignedIn() && request.resource.data.uploaderId == request.auth.uid) && moduleOn('academy');
      allow update: if (isTeacherOrAdmin()
        || (isStudent() && resource.data.uploaderId == request.auth.uid)) && moduleOn('academy');
      allow delete: if (isTeacherOrAdmin()
        || (isStudent() && resource.data.uploaderId == request.auth.uid)) && moduleOn('academy');

      match /comments/{commentId} {
        allow read: if (isSignedIn()) && moduleOn('academy');
        allow create: if (isSignedIn()
          && request.resource.data.userId == request.auth.uid) && moduleOn('academy');
        allow delete: if (isSignedIn()
          && (resource.data.userId == request.auth.uid || isTeacherOrAdmin())) && moduleOn('academy');
        allow update: if (false) && moduleOn('academy');
      }
    }

    // ── Production Bible / Student Guide ─────────────────────────────────────

    match /guide_sections/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /guide_articles/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /guide_contacts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Vehicles ─────────────────────────────────────────────────────────────

    match /vehicles/{vehicleId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── Food Box Orders ───────────────────────────────────────────────────────

    match /food_box_orders/{orderId} {
      allow read: if (isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)) && moduleOn('academy');
      allow create: if (isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending') && moduleOn('academy');
      allow update: if (isTeacherOrAdmin()) && moduleOn('academy');
      allow delete: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── Minivan Bookings ──────────────────────────────────────────────────────

    match /minivan_bookings/{bookingId} {
      allow read: if (isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)) && moduleOn('academy');
      allow create: if (isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending') && moduleOn('academy');
      allow update: if (isTeacherOrAdmin()) && moduleOn('academy');
      allow delete: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── Email Config ──────────────────────────────────────────────────────────

    match /email_config/{docId} {
      allow read: if isTeacherOrAdmin();
      allow write: if isAdmin();
    }

    // ── Equipment Booking System ───────────────────────────────────────────────

    match /equipment_categories/{catId} {
      allow read: if ((isSignedIn() && (isAdmin() || tierHasFeature('equipment')))
        || isRentalMode()) && moduleOn('rentalInventory');
      allow write: if (isAdmin()) && moduleOn('rentalInventory');
    }

    match /equipment/{itemId} {
      allow read: if ((isSignedIn() && (isAdmin() || tierHasFeature('equipment')))
        || isRentalMode()) && moduleOn('rentalInventory');
      allow write: if (isTeacherOrAdmin() && (isAdmin() || tierHasFeature('equipment'))) && moduleOn('rentalInventory');
    }

    match /equipment_bookings/{bookingId} {
      allow read: if ((isAdmin() || tierHasFeature('equipment'))
        && (isTeacherOrAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid))) && moduleOn('rentalInventory');
      // New bookings start pending, without decisions or project links (staff/functions set those)
      allow create: if (request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['categoryDecisions', 'setUpCategories', 'linkedProjectIds', 'linkedProjectId'])
        && (
          (isSignedIn() && tierHasFeature('equipment')
            && request.resource.data.studentId == request.auth.uid)
          || (isRentalMode() && request.resource.data.get('guestEmail', '') != ''
              && request.resource.data.get('isGuest', false) == true
              && request.resource.data.get('studentId', '') == '')
        )) && moduleOn('rentalInventory');
      allow update: if (isTeacherOrAdmin() && (isAdmin() || tierHasFeature('equipment'))
        || (isSignedIn() && resource.data.studentId == request.auth.uid
            && resource.data.status in ['pending', 'confirmed']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled')) && moduleOn('rentalInventory');
      allow delete: if (isTeacherOrAdmin() && (isAdmin() || tierHasFeature('equipment'))) && moduleOn('rentalInventory');

      match /messages/{messageId} {
        function bookingStudentId() {
          return get(/databases/$(database)/documents/equipment_bookings/$(bookingId)).data.studentId;
        }
        allow read: if ((isAdmin() || tierHasFeature('equipment'))
          && (isTeacherOrAdmin() || (isSignedIn() && bookingStudentId() == request.auth.uid))) && moduleOn('rentalInventory');
        allow create: if ((isAdmin() || tierHasFeature('equipment'))
          && request.resource.data.senderId == request.auth.uid
          && (
            (isTeacherOrAdmin() && request.resource.data.senderRole == 'staff')
            || (isSignedIn() && bookingStudentId() == request.auth.uid && request.resource.data.senderRole == 'student')
          )) && moduleOn('rentalInventory');
      }
    }

    match /inventory_projects/{projectId} {
      allow read: if (isSignedIn() && (isAdmin() || tierHasFeature('inventory'))) && moduleOn('rentalInventory');
      allow write: if (isTeacherOrAdmin() && (isAdmin() || tierHasFeature('inventory'))) && moduleOn('rentalInventory');

      match /items/{itemId} {
        allow read: if (isSignedIn() && (isAdmin() || tierHasFeature('inventory'))) && moduleOn('rentalInventory');
        allow write: if (isTeacherOrAdmin() && (isAdmin() || tierHasFeature('inventory'))) && moduleOn('rentalInventory');
      }

      // "This unit is out" markers used by the scanners (checkoutScan)
      match /unit_out/{lockId} {
        allow read, write: if (isTeacherOrAdmin() && (isAdmin() || tierHasFeature('inventory'))) && moduleOn('rentalInventory');
      }

      // Contract e-signatures — written only by the signEquipmentContract
      // function (server-captured evidence), never edited. Borrowers see their own.
      match /signatures/{sigId} {
        allow read: if (isTeacherOrAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid)) && moduleOn('rentalInventory');
        allow write: if (false) && moduleOn('rentalInventory');
      }
    }

    // Collection group rule required for collectionGroup('items') queries
    match /{path=**}/items/{itemId} {
      allow read: if (isSignedIn()) && moduleOn('rentalInventory');
    }

    // Collection-group reads of subject teachers (subject list instructors,
    // avatar sync in Profile, guest-teacher lookups). Mirrors the read rule on
    // subjects/{subjectId}/teachers; writes still go through that rule.
    match /{path=**}/teachers/{teacherId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
    }

    match /inventory_presets/{presetId} {
      allow read: if (isSignedIn() && (isAdmin() || tierHasFeature('inventory'))) && moduleOn('rentalInventory');
      allow write: if (isTeacherOrAdmin() && (isAdmin() || tierHasFeature('inventory'))) && moduleOn('rentalInventory');
    }

    // ── Scan sessions (cross-device QR scanning) ──────────────────────────────

    match /scan_sessions/{sessionId} {
      allow read: if (isSignedIn()) && moduleOn('rentalInventory');
      allow create: if (isTeacherOrAdmin()) && moduleOn('rentalInventory');
      allow update: if (isTeacherOrAdmin()) && moduleOn('rentalInventory');

      match /checkins/{checkinId} {
        allow read: if (isSignedIn()) && moduleOn('rentalInventory');
        allow create: if (isTeacherOrAdmin()) && moduleOn('rentalInventory'); // staff phones write check-in signals
      }
    }

    // ── Individual Development Plans (NOPRA) ──────────────────────────────────

    match /development_plans/{studentId} {
      allow read: if (isSelf(studentId) || isTeacherOrAdmin()) && moduleOn('academy');
      allow write: if (isSelf(studentId)) && moduleOn('academy');
    }

    // ── Plan comments (teacher → student feedback) ────────────────────────────

    match /plan_comments/{commentId} {
      allow read: if (isTeacherOrAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)) && moduleOn('academy');
      allow create: if (isTeacherOrAdmin()
        && request.resource.data.teacherId == request.auth.uid) && moduleOn('academy');
      allow delete: if (isTeacherOrAdmin()) && moduleOn('academy');
      allow update: if (false) && moduleOn('academy');
    }

    // ── Semester Events (Annual Wheel) ────────────────────────────────────────

    match /semester_events/{eventId} {
      allow read: if (isTeacherOrAdmin()) && moduleOn('academy');
      allow write: if (isAdmin()) && moduleOn('academy');
    }

    match /semester_categories/{catId} {
      allow read: if (isTeacherOrAdmin()) && moduleOn('academy');
      allow write: if (isAdmin()) && moduleOn('academy');
    }

    // ── Teacher Notebook ─────────────────────────────────────────────────

    match /teacher_notes/{noteId} {
      allow read, write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── GDPR deletion log — append by admins, read by admins ─────────────

    match /deletion_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Personal calendar events ──────────────────────────────────────────────

    match /personal_events/{eventId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || request.auth.uid in resource.data.inviteeIds);
      // notifiedIds is kept by sendEventInviteNotifications only (who has been told)
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.keys().hasAny(['notifiedIds']);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['notifiedIds']);
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // ── Office 365 calendar sync ───────────────────────────────────────────────
    // Contains a webhookSecret per doc — admin-only, never exposed to students/teachers.
    // The webhook itself writes via the Admin SDK and is not subject to these rules.

    match /office_calendar_syncs/{syncId} {
      allow read, write: if isAdmin();
    }

    match /synced_events/{eventId} {
      allow read: if isSignedIn();
      // Cloud Function creates/deletes; teachers may update override fields,
      // and delete occurrences Outlook removed without telling the flow
      allow update, delete: if isTeacherOrAdmin();
    }

    // ── Team Resources ────────────────────────────────────────────────────────

    match /resource_folders/{folderId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
      // Students can create folders scoped to their own cohort (class resources)
      allow create: if (isStudent()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.cohortId != null) && moduleOn('academy');
    }

    match /team_resources/{resourceId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      // Teachers/admins can create any resource; students can only create class resources (cohortId != null)
      allow create: if (isTeacherOrAdmin()
        && request.resource.data.createdBy == request.auth.uid) && moduleOn('academy');
      allow create: if (isStudent()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.cohortId != null) && moduleOn('academy');
      allow update, delete: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── Teacher Assessments (strengths / developments per student) ───────────

    match /teacher_assessments/{studentId} {
      // Students can read their own; teachers/admins can read all
      allow read: if (isSelf(studentId) || isTeacherOrAdmin()) && moduleOn('academy');
      // Only teachers/admins can write assessments
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── Crew Roles (admin-managed, student-readable) ──────────────────────────

    match /crew_roles/{roleId} {
      allow read: if (isSignedIn()) && (moduleOn('production') || moduleOn('rentalInventory'));
      allow write: if (isAdmin()) && moduleOn('production');
    }

    // ── Production Planning ───────────────────────────────────────────────────

    match /productions/{productionId} {
      function prodData() { return resource.data; }
      function canEditProd() {
        return prodData().createdBy == request.auth.uid
          || request.auth.uid in prodData().collaborators
          || isTeacherOrAdmin();
      }
      function canReadProd() {
        return canEditProd()
          || (prodData().isPublic && prodData().cohortId == request.auth.token.cohortId)
          || (prodData().sharedCohortIds != null && request.auth.token.cohortId in prodData().sharedCohortIds)
          || (prodData().viewerIds != null && request.auth.uid in prodData().viewerIds);
      }

      allow read: if (isSignedIn() && (isAdmin() || tierHasFeature('production')) && canReadProd()) && moduleOn('production');
      allow create: if (isSignedIn() && tierHasFeature('production')
        && request.resource.data.createdBy == request.auth.uid) && moduleOn('production');
      allow update: if (isSignedIn() && (isAdmin() || tierHasFeature('production')) && canEditProd()) && moduleOn('production');
      allow delete: if (isSignedIn() && (isAdmin() || tierHasFeature('production'))
        && (prodData().createdBy == request.auth.uid || isTeacherOrAdmin())) && moduleOn('production');

      // Every subcollection (cast, crew, budget, shotlog, …) follows the
      // production's own read/edit access
      match /{subcol}/{docId} {
        function parentProd() {
          return get(/databases/$(database)/documents/productions/$(productionId)).data;
        }
        function canEditSub() {
          return parentProd().createdBy == request.auth.uid
            || request.auth.uid in parentProd().get('collaborators', [])
            || isTeacherOrAdmin();
        }
        function canReadSub() {
          let p = parentProd();
          return canEditSub()
            || (p.get('isPublic', false) == true && p.get('cohortId', null) == request.auth.token.get('cohortId', null))
            || request.auth.token.get('cohortId', '') in p.get('sharedCohortIds', [])
            || request.auth.uid in p.get('viewerIds', []);
        }
        allow read: if (isSignedIn() && canReadSub()) && moduleOn('production');
        allow write: if (isSignedIn() && canEditSub()) && moduleOn('production');
      }
    }

    // ── Master Production Period ──────────────────────────────────────────────

    match /production_periods/{periodId} {
      allow read: if (isSignedIn()) && moduleOn('production');
      allow create: if (isTeacherOrAdmin()) && moduleOn('production');
      allow update: if (isTeacherOrAdmin()) && moduleOn('production');
      allow delete: if (isTeacherOrAdmin()) && moduleOn('production');

      match /allocations/{allocationId} {
        allow read: if (isSignedIn()) && moduleOn('production');
        allow create: if (isSignedIn()
          && request.resource.data.createdBy == request.auth.uid) && moduleOn('production');
        allow update: if (isSignedIn()
          && (resource.data.createdBy == request.auth.uid || isTeacherOrAdmin())) && moduleOn('production');
        allow delete: if (isSignedIn()
          && (resource.data.createdBy == request.auth.uid || isTeacherOrAdmin())) && moduleOn('production');
      }
    }

    // ── Student to-do items ───────────────────────────────────────────────────

    match /todos/{todoId} {
      // Ownership check rather than isStudent() — custom claims may not be set
      allow read: if (isSignedIn() && (
        isTeacherOrAdmin() || resource.data.studentId == request.auth.uid
      )) && moduleOn('academy');
      allow create: if (isSignedIn()
        && request.resource.data.studentId == request.auth.uid) && moduleOn('academy');
      allow update: if (isSignedIn()
        && resource.data.studentId == request.auth.uid) && moduleOn('academy');
      allow delete: if (isSignedIn()
        && resource.data.studentId == request.auth.uid) && moduleOn('academy');
    }

    // ── Schools ───────────────────────────────────────────────────────────────

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true
        && request.auth.token.email in ['fredrik.fridlund@gmail.com'];
    }

    match /_client_errors/{errorId} {
      // Size-capped so a script can't stuff huge documents in
      allow create: if isSignedIn()
        && request.resource.data.keys().size() <= 20
        && request.resource.data.get('message', '').size() <= 2000
        && (request.resource.data.get('stack', null) == null || request.resource.data.stack.size() <= 10000)
        && request.resource.data.get('context', '').size() <= 2000
        && request.resource.data.get('url', '').size() <= 2000
        && request.resource.data.get('ua', '').size() <= 500;
      allow read, update, delete: if isAdmin();
    }

    match /schools/{schoolId} {
      // Public existence check — allows unauthenticated slug availability check on signup
      allow get: if true;
      // Listing requires auth + admin role or superadmin email
      allow list: if isSignedIn() && (isAdmin() || isSuperAdmin());
      allow create: if isSignedIn() && (isAdmin() || isSuperAdmin())
        && request.resource.data.schoolId == schoolId
        && !exists(/databases/$(database)/documents/schools/$(schoolId));
      allow update: if isSignedIn() && (isAdmin() || isSuperAdmin());
      allow delete: if false;
    }

    // ── Guest Teacher Library ─────────────────────────────────────────────────

    match /guest_teachers/{teacherId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    match /guest_teacher_bookings/{bookingId} {
      allow read: if (isSignedIn()) && moduleOn('academy');
      allow write: if (isTeacherOrAdmin()) && moduleOn('academy');
    }

    // ── Notification inbox ────────────────────────────────────────────────────

    match /notifications/{notifId} {
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    // ── Contact requests (public contact form) ───────────────────────────────

    match /contact_requests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if false; // written only by the submitContactRequest function
    }

    // ── Bug reports ───────────────────────────────────────────────────────────

    match /bug_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.trim().size() > 0
        && request.resource.data.description.size() <= 2000;
      allow read: if isAdmin() || isSelf(resource.data.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
